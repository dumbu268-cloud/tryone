{
  "name": "tryone",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI Virtual Try-On — Phase 1: Live Mirror Foundation",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host --mode phone",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "setup": "node scripts/setup-models.mjs && node scripts/copy-wasm.mjs",
    "setup:models": "node scripts/setup-models.mjs",
    "postinstall": "node scripts/copy-wasm.mjs",
    "setup:test-media": "node scripts/fetch-test-media.mjs",
    "test:replay": "playwright test replay"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
